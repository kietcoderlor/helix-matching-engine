# Copy to .env. These values are for local simulation only.

# Engine
HELIX_BIND=127.0.0.1
HELIX_PORT=9001

# Gateway
HELIX_GATEWAY_PORT=3001
HELIX_ENGINE_HOST=127.0.0.1
HELIX_ENGINE_PORT=9001
DATABASE_URL=postgres://helix:helix@127.0.0.1:5432/helix
SESSION_TTL_HOURS=12

# Terminal (Vite)
VITE_GATEWAY_HTTP=http://127.0.0.1:3001
VITE_GATEWAY_WS=ws://127.0.0.1:3001/ws
